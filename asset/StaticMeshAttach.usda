#usda 1.0
(
    defaultPrim = "World"
    doc = """Test: cable attached directly to static Mesh prims via PhysicsAttachment.

    Demonstrates that PhysicsAttachment can target any prim carrying PhysicsRigidBodyAPI,
    including a def Mesh (not just Cube/Sphere shorthand primitives).

    Layout:
      BracketLeft  (def Mesh + PhysicsRigidBodyAPI, kinematicEnabled=true)  at x=-0.35
      BracketRight (def Mesh + PhysicsRigidBodyAPI, kinematicEnabled=true)  at x=+0.35
      Cable: 30 nodes, catenary sag ~15cm, node 0 attached to BracketLeft,
             node 29 attached to BracketRight.

    Tests:
      - physics:src1 relationship pointing to a def Mesh prim (real mesh topology)
      - Kinematic world-anchored mesh bodies (no parent joint, no ArticulationRoot needed)
      - Cable freely hangs between two static mesh anchors under gravity
      - PhysicsCollisionAPI on mesh allows cable capsules to rest on bracket surface"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Mesh "BracketLeft" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 0, 4, 7, 3, 1, 2, 6, 5]
        bool physics:kinematicEnabled = 1
        point3f[] points = [(-0.02, -0.02, -0.02), (0.02, -0.02, -0.02), (0.02, 0.02, -0.02), (-0.02, 0.02, -0.02), (-0.02, -0.02, 0.02), (0.02, -0.02, 0.02), (0.02, 0.02, 0.02), (-0.02, 0.02, 0.02)]
        uniform token subdivisionScheme = "none"
        double3 xformOp:translate = (-0.35, 0, 0.65)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Mesh "BracketRight" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
    )
    {
        int[] faceVertexCounts = [4, 4, 4, 4, 4, 4]
        int[] faceVertexIndices = [0, 3, 2, 1, 4, 5, 6, 7, 0, 1, 5, 4, 2, 3, 7, 6, 0, 4, 7, 3, 1, 2, 6, 5]
        bool physics:kinematicEnabled = 1
        point3f[] points = [(-0.02, -0.02, -0.02), (0.02, -0.02, -0.02), (0.02, 0.02, -0.02), (-0.02, 0.02, -0.02), (-0.02, -0.02, 0.02), (0.02, -0.02, 0.02), (0.02, 0.02, 0.02), (-0.02, 0.02, 0.02)]
        uniform token subdivisionScheme = "none"
        double3 xformOp:translate = (0.35, 0, 0.65)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "rod"
    {
        def Xform "curve_0" (
            apiSchemas = ["PhysicsDeformableBodyAPI", "MaterialBindingAPI", "NewtonArticulationRootAPI"]
        )
        {
            rel material:binding = </World/Looks/CablePhysicsMaterial> (
                bindMaterialAs = "weakerThanDescendants"
            )

            def BasisCurves "visual" (
                prepend apiSchemas = ["PhysicsCurvesDeformableSimAPI"]
            )
            {
                uniform token[] curveType = ["linear"]
                int[] curveVertexCounts = [30]
                point3f[] points = [(-0.35, 0, 0.65), (-0.32586, 0, 0.63002), (-0.30172, 0, 0.61147), (-0.27759, 0, 0.59435), (-0.25345, 0, 0.57866), (-0.22931, 0, 0.56439), (-0.20517, 0, 0.55155), (-0.18103, 0, 0.54013), (-0.1569, 0, 0.53014), (-0.13276, 0, 0.52158), (-0.10862, 0, 0.51445), (-0.08448, 0, 0.50874), (-0.06034, 0, 0.50446), (-0.03621, 0, 0.50161), (-0.01207, 0, 0.50018), (0.01207, 0, 0.50018), (0.03621, 0, 0.50161), (0.06034, 0, 0.50446), (0.08448, 0, 0.50874), (0.10862, 0, 0.51445), (0.13276, 0, 0.52158), (0.1569, 0, 0.53014), (0.18103, 0, 0.54013), (0.20517, 0, 0.55155), (0.22931, 0, 0.56439), (0.25345, 0, 0.57866), (0.27759, 0, 0.59435), (0.30172, 0, 0.61147), (0.32586, 0, 0.63002), (0.35, 0, 0.65)]
                uniform token type = "linear"
                float[] widths = [0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005, 0.005]
                uniform token wrap = "nonperiodic"
            }

            def PhysicsAttachment "attachment_left"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = [(0, 0, 0)]
                float physics:damping = 0
                int[] physics:indices0 = [0]
                int[] physics:indices1 = []
                rel physics:src0 = </World/rod/curve_0/visual>
                rel physics:src1 = </World/BracketLeft>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "xform"
            }

            def PhysicsAttachment "attachment_right"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = [(0, 0, 0)]
                float physics:damping = 0
                int[] physics:indices0 = [29]
                int[] physics:indices1 = []
                rel physics:src0 = </World/rod/curve_0/visual>
                rel physics:src1 = </World/BracketRight>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "xform"
            }
        }
    }

    def Scope "Looks"
    {
        def Material "CablePhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysicsCurvesDeformableMaterialAPI", "NewtonMaterialAPI", "NewtonCurvesDeformableMaterialAPI"]
        )
        {
            float newton:bendDamping = 0.1
            float newton:contactDamping = 1
            float newton:contactStiffness = 100
            float newton:stretchDamping = 0.00001
            float physics:bendStiffness = 5806.824
            float physics:dynamicFriction = 0.5
            float physics:staticFriction = 0.5
            float physics:stretchStiffness = 580682.44
            float physics:thickness = 0.005
        }
    }
}
