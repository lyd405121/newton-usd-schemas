#usda 1.0
(
    defaultPrim = "World"
    doc = """Test: Cable harness graph with 4 attachments — each connector is a cube
    with its own articulated joint connecting to a wall mount.

    Topology: same double-Y (16 nodes, 15 edges) as test_graph.usda.

    Assemblies:
      WallMount  (static cube) --revolute Y--> MountCube --> cable node 0
      SlotA      (static cube) --revolute Z--> ConnectorA --> cable node 9
      SlotB      (static cube) --prismatic Z-> ConnectorB --> cable node 12
      SlotC      (static cube) --revolute X--> ConnectorC --> cable node 15

    Each assembly has PhysicsArticulationRootAPI on the top Xform.
    The cable follows AOUSD curve-deformable authoring and uses NewtonArticulationRootAPI for importer articulation wrapping.
    Four PhysicsAttachment prims link cable endpoints to the cube bodies.

    Tests:
      - Cable attached to bodies that are themselves children in articulations
      - Mixed joint types: 3x revolute + 1x prismatic
      - non-identity localRot1 on ConnectorC slot (body rotated 90° around Z)
      - localPos1 socket offsets on connectors"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "Assembly0" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        def Cube "WallMount" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            double size = 0.04
            double3 xformOp:translate = (-0.3, 0, 0.56)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cube "MountCube" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            float physics:mass = 0.02
            double size = 0.03
            double3 xformOp:translate = (-0.3, 0, 0.5)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def PhysicsRevoluteJoint "RevJoint0"
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/Assembly0/WallMount>
            rel physics:body1 = </World/Assembly0/MountCube>
            point3f physics:localPos0 = (0, 0, -0.03)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -30
            float physics:upperLimit = 30
        }
    }

    def Xform "AssemblyA" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        def Cube "SlotA" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            double size = 0.04
            double3 xformOp:translate = (-0.1, 0.28, 0.38)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cube "ConnectorA" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            float physics:mass = 0.02
            double size = 0.025
            double3 xformOp:translate = (-0.1, 0.24, 0.44)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def PhysicsRevoluteJoint "RevJointA"
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </World/AssemblyA/SlotA>
            rel physics:body1 = </World/AssemblyA/ConnectorA>
            point3f physics:localPos0 = (0, -0.02, 0.03)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -45
            float physics:upperLimit = 45
        }
    }

    def Xform "AssemblyB" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        def Cube "SlotB" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            double size = 0.04
            double3 xformOp:translate = (-0.1, -0.28, 0.38)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cube "ConnectorB" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            float physics:mass = 0.02
            double size = 0.025
            double3 xformOp:translate = (-0.1, -0.24, 0.44)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def PhysicsPrismaticJoint "PrisJointB"
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </World/AssemblyB/SlotB>
            rel physics:body1 = </World/AssemblyB/ConnectorB>
            point3f physics:localPos0 = (0, 0, 0.03)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.04
            float physics:upperLimit = 0.04
        }
    }

    def Xform "AssemblyC" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        def Cube "SlotC" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            double size = 0.04
            quatf xformOp:orient = (0.70710677, 0, 0, 0.70710677)
            double3 xformOp:translate = (0.2, 0.28, 0.38)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def Cube "ConnectorC" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            float physics:mass = 0.02
            double size = 0.025
            quatf xformOp:orient = (0.70710677, 0, 0, 0.70710677)
            double3 xformOp:translate = (0.2, 0.24, 0.44)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:orient"]
        }

        def PhysicsRevoluteJoint "RevJointC"
        {
            uniform token physics:axis = "X"
            rel physics:body0 = </World/AssemblyC/SlotC>
            rel physics:body1 = </World/AssemblyC/ConnectorC>
            point3f physics:localPos0 = (0, -0.02, 0.03)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -30
            float physics:upperLimit = 30
        }
    }

    def Xform "rod_graph"
    {
        def Xform "curve_0" (
            apiSchemas = ["PhysicsDeformableBodyAPI", "MaterialBindingAPI", "NewtonArticulationRootAPI"]
        )
        {
            rel material:binding = </World/Looks/CablePhysicsMaterial> (
                bindMaterialAs = "weakerThanDescendants"
            )

            def BasisCurves "visual_trunk" (
                prepend apiSchemas = ["PhysicsCurvesDeformableSimAPI"]
            )
            {
                uniform token[] curveType = ["linear"]
                int[] curveVertexCounts = [7]
                point3f[] points = [(-0.3, 0, 0.5), (-0.2, 0, 0.5), (-0.1, 0, 0.5), (0, 0, 0.5), (0.1, 0, 0.5), (0.2, 0, 0.5), (0.3, 0, 0.5)]
                uniform token type = "linear"
                float[] widths = [0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01]
                uniform token wrap = "nonperiodic"
            }

            def BasisCurves "visual_branchA" (
                prepend apiSchemas = ["PhysicsCurvesDeformableSimAPI"]
            )
            {
                uniform token[] curveType = ["linear"]
                int[] curveVertexCounts = [4]
                point3f[] points = [(-0.1, 0, 0.5), (-0.1, 0.08, 0.485), (-0.1, 0.16, 0.465), (-0.1, 0.24, 0.44)]
                uniform token type = "linear"
                float[] widths = [0.01, 0.009, 0.008, 0.007]
                uniform token wrap = "nonperiodic"
            }

            def BasisCurves "visual_branchB" (
                prepend apiSchemas = ["PhysicsCurvesDeformableSimAPI"]
            )
            {
                uniform token[] curveType = ["linear"]
                int[] curveVertexCounts = [4]
                point3f[] points = [(-0.1, 0, 0.5), (-0.1, -0.08, 0.485), (-0.1, -0.16, 0.465), (-0.1, -0.24, 0.44)]
                uniform token type = "linear"
                float[] widths = [0.01, 0.009, 0.008, 0.007]
                uniform token wrap = "nonperiodic"
            }

            def BasisCurves "visual_branchC" (
                prepend apiSchemas = ["PhysicsCurvesDeformableSimAPI"]
            )
            {
                uniform token[] curveType = ["linear"]
                int[] curveVertexCounts = [4]
                point3f[] points = [(0.2, 0, 0.5), (0.2, 0.08, 0.485), (0.2, 0.16, 0.465), (0.2, 0.24, 0.44)]
                uniform token type = "linear"
                float[] widths = [0.01, 0.009, 0.008, 0.007]
                uniform token wrap = "nonperiodic"
            }


            def PhysicsAttachment "junction_branchA"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = []
                float physics:damping = 0
                int[] physics:indices0 = [0]
                int[] physics:indices1 = [2]
                rel physics:src0 = </World/rod_graph/curve_0/visual_branchA>
                rel physics:src1 = </World/rod_graph/curve_0/visual_trunk>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "point"
            }

            def PhysicsAttachment "junction_branchB"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = []
                float physics:damping = 0
                int[] physics:indices0 = [0]
                int[] physics:indices1 = [2]
                rel physics:src0 = </World/rod_graph/curve_0/visual_branchB>
                rel physics:src1 = </World/rod_graph/curve_0/visual_trunk>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "point"
            }

            def PhysicsAttachment "junction_branchC"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = []
                float physics:damping = 0
                int[] physics:indices0 = [0]
                int[] physics:indices1 = [5]
                rel physics:src0 = </World/rod_graph/curve_0/visual_branchC>
                rel physics:src1 = </World/rod_graph/curve_0/visual_trunk>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "point"
            }

            def PhysicsAttachment "attachment_trunk"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = [(0, 0, 0)]
                float physics:damping = 0
                int[] physics:indices0 = [0]
                int[] physics:indices1 = []
                rel physics:src0 = </World/rod_graph/curve_0/visual_trunk>
                rel physics:src1 = </World/Assembly0/MountCube>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "xform"
            }

            def PhysicsAttachment "attachment_connA"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = [(0, 0, -0.005)]
                float physics:damping = 0
                int[] physics:indices0 = [3]
                int[] physics:indices1 = []
                rel physics:src0 = </World/rod_graph/curve_0/visual_branchA>
                rel physics:src1 = </World/AssemblyA/ConnectorA>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "xform"
            }

            def PhysicsAttachment "attachment_connB"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = [(0, 0, -0.005)]
                float physics:damping = 0
                int[] physics:indices0 = [3]
                int[] physics:indices1 = []
                rel physics:src0 = </World/rod_graph/curve_0/visual_branchB>
                rel physics:src1 = </World/AssemblyB/ConnectorB>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "xform"
            }

            def PhysicsAttachment "attachment_connC"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = [(0, 0, -0.005)]
                float physics:damping = 0
                int[] physics:indices0 = [3]
                int[] physics:indices1 = []
                rel physics:src0 = </World/rod_graph/curve_0/visual_branchC>
                rel physics:src1 = </World/AssemblyC/ConnectorC>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "xform"
            }
        }
    }

    def Scope "Looks"
    {
        def Material "CablePhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysicsCurvesDeformableMaterialAPI", "NewtonMaterialAPI", "NewtonCurvesDeformableMaterialAPI"]
        )
        {
            float newton:bendDamping = 0.002
            float newton:contactDamping = 1
            float newton:contactStiffness = 100
            float newton:stretchDamping = 0
            float physics:bendStiffness = 5000
            float physics:dynamicFriction = 0.5
            float physics:staticFriction = 0.5
            float physics:stretchStiffness = 300000
            float physics:thickness = 0.01
        }
    }
}
