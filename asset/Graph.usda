#usda 1.0
(
    defaultPrim = "World"
    doc = """Test: Cable harness with double-Y topology (two junctions, four branch tips).

    Topology (16 nodes, 15 edges):
      Trunk:    0-1-2-3-4-5-6  (6 edges along X, z=0.5)
      Branch A: 2-7-8-9        (3 edges from node 2, going +Y and dropping)
      Branch B: 2-10-11-12     (3 edges from node 2, going -Y and dropping)
      Branch C: 5-13-14-15     (3 edges from node 5, going +Y and dropping)

    Node 0 is fixed (trunk root). All 4 branch tips are free.
    Trunk is stiffer than branches. Per-segment stiffness array (15 values).
    Branch widths are thinner than trunk.

    Tests:
      - Two junctions (nodes 2 and 5, degree 3)
      - 15-element per-segment stiffness arrays
      - Mixed segment lengths (trunk 0.1m, branches 0.09m)
      - Graph topology represented as multiple AOUSD curve strands"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "rod_graph"
    {
        def Xform "curve_0" (
            apiSchemas = ["PhysicsDeformableBodyAPI", "MaterialBindingAPI", "NewtonArticulationRootAPI"]
        )
        {
            rel material:binding = </World/Looks/CablePhysicsMaterial> (
                bindMaterialAs = "weakerThanDescendants"
            )

            def BasisCurves "visual_trunk" (
                prepend apiSchemas = ["PhysicsCurvesDeformableSimAPI"]
            )
            {
                uniform token[] curveType = ["linear"]
                int[] curveVertexCounts = [7]
                point3f[] points = [(-0.3, 0, 0.5), (-0.2, 0, 0.5), (-0.1, 0, 0.5), (0, 0, 0.5), (0.1, 0, 0.5), (0.2, 0, 0.5), (0.3, 0, 0.5)]
                uniform token type = "linear"
                float[] widths = [0.01, 0.01, 0.01, 0.01, 0.01, 0.01, 0.01]
                uniform token wrap = "nonperiodic"
            }

            def BasisCurves "visual_branchA" (
                prepend apiSchemas = ["PhysicsCurvesDeformableSimAPI"]
            )
            {
                uniform token[] curveType = ["linear"]
                int[] curveVertexCounts = [4]
                point3f[] points = [(-0.1, 0, 0.5), (-0.1, 0.08, 0.485), (-0.1, 0.16, 0.465), (-0.1, 0.24, 0.44)]
                uniform token type = "linear"
                float[] widths = [0.01, 0.009, 0.008, 0.007]
                uniform token wrap = "nonperiodic"
            }

            def BasisCurves "visual_branchB" (
                prepend apiSchemas = ["PhysicsCurvesDeformableSimAPI"]
            )
            {
                uniform token[] curveType = ["linear"]
                int[] curveVertexCounts = [4]
                point3f[] points = [(-0.1, 0, 0.5), (-0.1, -0.08, 0.485), (-0.1, -0.16, 0.465), (-0.1, -0.24, 0.44)]
                uniform token type = "linear"
                float[] widths = [0.01, 0.009, 0.008, 0.007]
                uniform token wrap = "nonperiodic"
            }

            def BasisCurves "visual_branchC" (
                prepend apiSchemas = ["PhysicsCurvesDeformableSimAPI"]
            )
            {
                uniform token[] curveType = ["linear"]
                int[] curveVertexCounts = [4]
                point3f[] points = [(0.2, 0, 0.5), (0.2, 0.08, 0.485), (0.2, 0.16, 0.465), (0.2, 0.24, 0.44)]
                uniform token type = "linear"
                float[] widths = [0.01, 0.009, 0.008, 0.007]
                uniform token wrap = "nonperiodic"
            }


            def PhysicsAttachment "junction_branchA"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = []
                float physics:damping = 0
                int[] physics:indices0 = [0]
                int[] physics:indices1 = [2]
                rel physics:src0 = </World/rod_graph/curve_0/visual_branchA>
                rel physics:src1 = </World/rod_graph/curve_0/visual_trunk>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "point"
            }

            def PhysicsAttachment "junction_branchB"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = []
                float physics:damping = 0
                int[] physics:indices0 = [0]
                int[] physics:indices1 = [2]
                rel physics:src0 = </World/rod_graph/curve_0/visual_branchB>
                rel physics:src1 = </World/rod_graph/curve_0/visual_trunk>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "point"
            }

            def PhysicsAttachment "junction_branchC"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = []
                float physics:damping = 0
                int[] physics:indices0 = [0]
                int[] physics:indices1 = [5]
                rel physics:src0 = </World/rod_graph/curve_0/visual_branchC>
                rel physics:src1 = </World/rod_graph/curve_0/visual_trunk>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "point"
            }

            def PhysicsAttachment "fixed_point_0"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = [(-0.3, 0, 0.5)]
                float physics:damping = 0
                int[] physics:indices0 = [0]
                int[] physics:indices1 = []
                rel physics:src0 = </World/rod_graph/curve_0/visual_trunk>
                rel physics:src1 = </World>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "xform"
            }
        }
    }

    def Scope "Looks"
    {
        def Material "CablePhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysicsCurvesDeformableMaterialAPI", "NewtonMaterialAPI", "NewtonCurvesDeformableMaterialAPI"]
        )
        {
            float newton:bendDamping = 0.002
            float newton:contactDamping = 1
            float newton:contactStiffness = 100
            float newton:stretchDamping = 0
            float physics:bendStiffness = 5000
            float physics:dynamicFriction = 0.5
            float physics:staticFriction = 0.5
            float physics:stretchStiffness = 300000
            float physics:thickness = 0.01
        }
    }
}
