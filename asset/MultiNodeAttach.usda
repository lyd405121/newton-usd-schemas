#usda 1.0
(
    defaultPrim = "World"
    doc = """Test: multiple rod nodes attached to one rigid body by one NewtonRodAttachmentAPI prim.

    The first three rod nodes are attached to the same kinematic mount cube. The
    newton:localPos1 array provides three body-local socket positions, one per
    node in newton:nodeIndices.

    Tests:
      - int[] newton:nodeIndices with multiple entries
      - point3f[] newton:localPos1 matching nodeIndices length
      - One rel newton:body target shared by all listed rod nodes"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Cube "MountBlock" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
    )
    {
        bool physics:kinematicEnabled = 1
        double size = 0.06
        double3 xformOp:translate = (-0.24, 0, 0.55)
        uniform token[] xformOpOrder = ["xformOp:translate"]
    }

    def Xform "rod" (
        prepend apiSchemas = ["NewtonRodAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/CablePhysicsMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
        float[] newton:bendDamping = [0.01]
        float[] newton:bendStiffness = [1000]
        int2[] newton:edges = [(0, 3), (1, 3), (2, 3), (3, 4), (4, 5), (5, 6)]
        point3f[] newton:points = [(-0.24, -0.04, 0.55), (-0.24, 0, 0.55), (-0.24, 0.04, 0.55), (-0.12, 0, 0.5), (0, 0, 0.47), (0.12, 0, 0.45), (0.24, 0, 0.44)]
        float[] newton:radius = [0.004]
        float[] newton:stretchDamping = [0]
        float[] newton:stretchStiffness = [200000]
        bool newton:wrapInArticulation = 1

        def BasisCurves "visual_top" (
            prepend apiSchemas = ["NewtonRodVisualCurveAPI"]
        )
        {
            uniform token[] curveType = ["linear"]
            int[] curveVertexCounts = [5]
            int[] newton:rodPointIndices = [0, 3, 4, 5, 6]
            point3f[] points = [(-0.24, -0.04, 0.55), (-0.12, 0, 0.5), (0, 0, 0.47), (0.12, 0, 0.45), (0.24, 0, 0.44)]
            uniform token type = "linear"
            float[] widths = [0.008, 0.008, 0.008, 0.008, 0.008]
            uniform token wrap = "nonperiodic"
        }

        def BasisCurves "visual_middle" (
            prepend apiSchemas = ["NewtonRodVisualCurveAPI"]
        )
        {
            uniform token[] curveType = ["linear"]
            int[] curveVertexCounts = [5]
            int[] newton:rodPointIndices = [1, 3, 4, 5, 6]
            point3f[] points = [(-0.24, 0, 0.55), (-0.12, 0, 0.5), (0, 0, 0.47), (0.12, 0, 0.45), (0.24, 0, 0.44)]
            uniform token type = "linear"
            float[] widths = [0.008, 0.008, 0.008, 0.008, 0.008]
            uniform token wrap = "nonperiodic"
        }

        def BasisCurves "visual_bottom" (
            prepend apiSchemas = ["NewtonRodVisualCurveAPI"]
        )
        {
            uniform token[] curveType = ["linear"]
            int[] curveVertexCounts = [5]
            int[] newton:rodPointIndices = [2, 3, 4, 5, 6]
            point3f[] points = [(-0.24, 0.04, 0.55), (-0.12, 0, 0.5), (0, 0, 0.47), (0.12, 0, 0.45), (0.24, 0, 0.44)]
            uniform token type = "linear"
            float[] widths = [0.008, 0.008, 0.008, 0.008, 0.008]
            uniform token wrap = "nonperiodic"
        }

        def Xform "attach_mount_block" (
            prepend apiSchemas = ["NewtonRodAttachmentAPI"]
        )
        {
            rel newton:body = </World/MountBlock>
            point3f[] newton:localPos1 = [(0, -0.04, 0), (0, 0, 0), (0, 0.04, 0)]
            int[] newton:nodeIndices = [0, 1, 2]
        }
    }

    def Scope "Looks"
    {
        def Material "CablePhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:contactDamping = 1
            float newton:contactStiffness = 100
            float physics:dynamicFriction = 0.5
            float physics:staticFriction = 0.5
        }
    }
}

