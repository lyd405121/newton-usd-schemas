#usda 1.0
(
    defaultPrim = "World"
    doc = """Test: Closed-loop heart-shaped cable with explicit edge topology.

    A heart-shaped ring of 48 nodes lying in the XZ plane at y=0, z-center=0.5.
    Generated via arc-length-uniform resampling of the classic parametric heart:
      x = 16 sin^3(t),  y = 13 cos(t) - 5 cos(2t) - 2 cos(3t) - cos(4t)
    Scaled to fit within ±0.14m. Segment lengths: min~1.2mm, max~18.6mm (heart cusp).

    The ring is free-hanging (no attachments).
    The explicit newton:edges topology includes a loop-closing edge between node 47 and node 0.

    Tests:
      - Explicit loop-closing edge
      - wrapInArticulation = true
      - Non-uniform segment lengths (heart cusp geometry)
      - Free-hanging ring under gravity"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "ring" (
        prepend apiSchemas = ["NewtonRodAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/CablePhysicsMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
        float[] newton:bendDamping = [0.001]
        float[] newton:bendStiffness = [800]
        float newton:contact_kd = 1
