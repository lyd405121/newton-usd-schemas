#usda 1.0
(
    defaultPrim = "World"
    doc = '''Test: closed-loop heart-shaped cable using periodic BasisCurves.

    A heart-shaped ring of 48 nodes lying in the XZ plane at y=0, z-center=0.5.
    Generated via arc-length-uniform resampling of the classic parametric heart:
      x = 16 sin^3(t),  y = 13 cos(t) - 5 cos(2t) - 2 cos(3t) - cos(4t)
    Scaled to fit within ±0.14m. Segment lengths: min~1.2mm, max~18.6mm (heart cusp).

    The ring is free-hanging (no fixed-point attachments).
    uniform token wrap = "periodic" closes the curve between node 47 and node 0.

    Tests:
      - BasisCurves wrap = "periodic" (loop-closing joint)
      - NewtonArticulationRootAPI requests importer articulation wrapping
      - Non-uniform segment lengths (heart cusp geometry)
      - Free-hanging ring under gravity'''
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "ring"
    {
        def Xform "curve_0" (
            apiSchemas = ["PhysicsDeformableBodyAPI", "MaterialBindingAPI", "NewtonArticulationRootAPI"]
        )
        {
            rel material:binding = </World/Looks/CablePhysicsMaterial> (
                bindMaterialAs = "weakerThanDescendants"
            )

            def BasisCurves "visual" (
                prepend apiSchemas = ["PhysicsCurvesDeformableSimAPI"]
            )
            {
                uniform token[] curveType = ["linear"]
                int[] curveVertexCounts = [48]
                point3f[] points = [(0, 0, 0.56596), (0.00491, 0, 0.58383), (0.01455, 0, 0.59971), (0.0278, 0, 0.61273), (0.04397, 0, 0.62185), (0.06201, 0, 0.62622), (0.08056, 0, 0.62549), (0.09828, 0, 0.61991), (0.11403, 0, 0.61007), (0.12685, 0, 0.59663), (0.13575, 0, 0.58033), (0.13981, 0, 0.56222), (0.13863, 0, 0.54369), (0.1328, 0, 0.52605), (0.12354, 0, 0.50992), (0.11203, 0, 0.49528), (0.09916, 0, 0.48183), (0.08549, 0, 0.46919), (0.07142, 0, 0.45698), (0.05725, 0, 0.44489), (0.04327, 0, 0.43259), (0.0298, 0, 0.41973), (0.01729, 0, 0.40594), (0.00656, 0, 0.39074), (0, 0, 0.37346), (-0.00656, 0, 0.39074), (-0.01729, 0, 0.40594), (-0.0298, 0, 0.41973), (-0.04327, 0, 0.43259), (-0.05725, 0, 0.44489), (-0.07142, 0, 0.45698), (-0.08549, 0, 0.46919), (-0.09916, 0, 0.48183), (-0.11203, 0, 0.49528), (-0.12354, 0, 0.50992), (-0.1328, 0, 0.52605), (-0.13863, 0, 0.54369), (-0.13981, 0, 0.56222), (-0.13575, 0, 0.58033), (-0.12685, 0, 0.59663), (-0.11403, 0, 0.61007), (-0.09828, 0, 0.61991), (-0.08056, 0, 0.62549), (-0.06201, 0, 0.62622), (-0.04397, 0, 0.62185), (-0.0278, 0, 0.61273), (-0.01455, 0, 0.59971), (-0.00491, 0, 0.58383)]
                uniform token type = "linear"
                float[] widths = [0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008, 0.008]
                uniform token wrap = "periodic"
            }
        }
    }

    def Scope "Looks"
    {
        def Material "CablePhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysicsCurvesDeformableMaterialAPI", "NewtonMaterialAPI", "NewtonCurvesDeformableMaterialAPI"]
        )
        {
            float newton:bendDamping = 0.0
            float newton:contactDamping = 100
            float newton:contactStiffness = 2500
            float newton:stretchDamping = 0
            float physics:bendStiffness = 1500000000
            float physics:dynamicFriction = 0.5
            float physics:staticFriction = 0.5
            float physics:stretchStiffness = 150000000
            float physics:thickness = 0.008
        }
    }
}
