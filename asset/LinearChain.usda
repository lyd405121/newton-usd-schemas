#usda 1.0
(
    defaultPrim = "World"
    doc = """Test: 40-node sagging cable with per-segment stiffness and tapered width.

    Shape: catenary sag from (-0.4, 0, 0.65) to (0.4, 0, 0.65), sag depth ~0.28m.
    First 5 nodes are kinematic (fixed end).
    Stiffness is higher near the fixed end (segments 0-9) and softer toward the free end.
    Width tapers from 8mm at tips to 12mm at midpoint (sinusoidal profile).
    Self-collision filter: all pairs filtered by _filter_cable_self_collisions in builder.

    Tests:
      - 39 per-segment stretchStiffness / bendStiffness arrays (N-1 length)
      - Tapered widths array
      - PhysicsAttachment pins for 5 kinematic nodes
      - AOUSD BasisCurves plus PhysicsAttachment fixed points"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "rod"
    {
        def Xform "curve_0" (
            apiSchemas = ["PhysicsDeformableBodyAPI", "MaterialBindingAPI", "NewtonArticulationRootAPI"]
        )
        {
            rel material:binding = </World/Looks/CablePhysicsMaterial> (
                bindMaterialAs = "weakerThanDescendants"
            )

            def BasisCurves "visual" (
                prepend apiSchemas = ["PhysicsCurvesDeformableSimAPI"]
            )
            {
                uniform token[] curveType = ["linear"]
                int[] curveVertexCounts = [40]
                point3f[] points = [(-0.4, 0, 0.65), (-0.37949, 0, 0.62202), (-0.35897, 0, 0.59551), (-0.33846, 0, 0.57046), (-0.31795, 0, 0.54688), (-0.29744, 0, 0.52476), (-0.27692, 0, 0.50411), (-0.25641, 0, 0.48492), (-0.2359, 0, 0.4672), (-0.21538, 0, 0.45094), (-0.19487, 0, 0.43615), (-0.17436, 0, 0.42282), (-0.15385, 0, 0.41096), (-0.13333, 0, 0.40057), (-0.11282, 0, 0.39164), (-0.09231, 0, 0.38418), (-0.07179, 0, 0.37818), (-0.05128, 0, 0.37365), (-0.03077, 0, 0.37059), (-0.01026, 0, 0.36899), (0.01026, 0, 0.36886), (0.03077, 0, 0.37019), (0.05128, 0, 0.37299), (0.07179, 0, 0.37726), (0.09231, 0, 0.38299), (0.11282, 0, 0.39019), (0.13333, 0, 0.39886), (0.15385, 0, 0.40899), (0.17436, 0, 0.42059), (0.19487, 0, 0.43366), (0.21538, 0, 0.44819), (0.2359, 0, 0.46418), (0.25641, 0, 0.48164), (0.27692, 0, 0.50057), (0.29744, 0, 0.52096), (0.31795, 0, 0.54281), (0.33846, 0, 0.56613), (0.35897, 0, 0.59092), (0.37949, 0, 0.61717), (0.4, 0, 0.64488)]
                uniform token type = "linear"
                float[] widths = [0.008, 0.00832, 0.00864, 0.00896, 0.00927, 0.00958, 0.00988, 0.01016, 0.01043, 0.01069, 0.01093, 0.01116, 0.01136, 0.01155, 0.01171, 0.01185, 0.01197, 0.01206, 0.01213, 0.01218, 0.0122, 0.01218, 0.01214, 0.01207, 0.01197, 0.01185, 0.0117, 0.01153, 0.01133, 0.01111, 0.01087, 0.01061, 0.01033, 0.01003, 0.00972, 0.00939, 0.00905, 0.0087, 0.00834, 0.008]
                uniform token wrap = "nonperiodic"
            }

            def PhysicsAttachment "fixed_point_0"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = [(-0.4, 0, 0.65)]
                float physics:damping = 0
                int[] physics:indices0 = [0]
                int[] physics:indices1 = []
                rel physics:src0 = </World/rod/curve_0/visual>
                rel physics:src1 = </World>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "xform"
            }

            def PhysicsAttachment "fixed_point_1"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = [(-0.37949, 0, 0.62202)]
                float physics:damping = 0
                int[] physics:indices0 = [1]
                int[] physics:indices1 = []
                rel physics:src0 = </World/rod/curve_0/visual>
                rel physics:src1 = </World>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "xform"
            }

            def PhysicsAttachment "fixed_point_2"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = [(-0.35897, 0, 0.59551)]
                float physics:damping = 0
                int[] physics:indices0 = [2]
                int[] physics:indices1 = []
                rel physics:src0 = </World/rod/curve_0/visual>
                rel physics:src1 = </World>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "xform"
            }

            def PhysicsAttachment "fixed_point_3"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = [(-0.33846, 0, 0.57046)]
                float physics:damping = 0
                int[] physics:indices0 = [3]
                int[] physics:indices1 = []
                rel physics:src0 = </World/rod/curve_0/visual>
                rel physics:src1 = </World>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "xform"
            }

            def PhysicsAttachment "fixed_point_4"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = [(-0.31795, 0, 0.54688)]
                float physics:damping = 0
                int[] physics:indices0 = [4]
                int[] physics:indices1 = []
                rel physics:src0 = </World/rod/curve_0/visual>
                rel physics:src1 = </World>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "xform"
            }
        }
    }

    def Scope "Looks"
    {
        def Material "CablePhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysicsCurvesDeformableMaterialAPI", "NewtonMaterialAPI", "NewtonCurvesDeformableMaterialAPI"]
        )
        {
            float newton:bendDamping = 0.001
            float newton:contactDamping = 1
            float newton:contactStiffness = 100
            float newton:stretchDamping = 0
            float physics:bendStiffness = 2000
            float physics:dynamicFriction = 0.5
            float physics:staticFriction = 0.5
            float physics:stretchStiffness = 200000
            float physics:thickness = 0.008
        }
    }
}
