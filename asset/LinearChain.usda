                point3f[] points = [(-0.40000, 0.00000, 0.65000), (-0.37949, 0.00000, 0.62202), (-0.35897, 0.00000, 0.59551), (-0.33846, 0.00000, 0.57046), (-0.31795, 0.00000, 0.54688), (-0.29744, 0.00000, 0.52476), (-0.27692, 0.00000, 0.50411), (-0.25641, 0.00000, 0.48492), (-0.23590, 0.00000, 0.46720), (-0.21538, 0.00000, 0.45094), (-0.19487, 0.00000, 0.43615), (-0.17436, 0.00000, 0.42282), (-0.15385, 0.00000, 0.41096), (-0.13333, 0.00000, 0.40057), (-0.11282, 0.00000, 0.39164), (-0.09231, 0.00000, 0.38418), (-0.07179, 0.00000, 0.37818), (-0.05128, 0.00000, 0.37365), (-0.03077, 0.00000, 0.37059), (-0.01026, 0.00000, 0.36899), (0.01026, 0.00000, 0.36886), (0.03077, 0.00000, 0.37019), (0.05128, 0.00000, 0.37299), (0.07179, 0.00000, 0.37726), (0.09231, 0.00000, 0.38299), (0.11282, 0.00000, 0.39019), (0.13333, 0.00000, 0.39886), (0.15385, 0.00000, 0.40899), (0.17436, 0.00000, 0.42059), (0.19487, 0.00000, 0.43366), (0.21538, 0.00000, 0.44819), (0.23590, 0.00000, 0.46418), (0.25641, 0.00000, 0.48164), (0.27692, 0.00000, 0.50057), (0.29744, 0.00000, 0.52096), (0.31795, 0.00000, 0.54281), (0.33846, 0.00000, 0.56613), (0.35897, 0.00000, 0.59092), (0.37949, 0.00000, 0.61717), (0.40000, 0.00000, 0.64488)]
            }
        }
    }
    def Scope "Looks"
    {
        def Material "CablePhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float physics:dynamicFriction = 0.5
            float physics:staticFriction = 0.5
            float newton:contactStiffness = 100.0
            float newton:contactDamping = 1.0
        }
    }
}
