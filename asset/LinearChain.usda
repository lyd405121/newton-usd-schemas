            uniform token type = "linear"
            float[] widths = [0.008, 0.00832, 0.00864, 0.00896, 0.00927, 0.00958, 0.00988, 0.01016, 0.01043, 0.01069, 0.01093, 0.01116, 0.01136, 0.01155, 0.01171, 0.01185, 0.01197, 0.01206, 0.01213, 0.01218, 0.0122, 0.01218, 0.01214, 0.01207, 0.01197, 0.01185, 0.0117, 0.01153, 0.01133, 0.01111, 0.01087, 0.01061, 0.01033, 0.01003, 0.00972, 0.00939, 0.00905, 0.0087, 0.00834, 0.008]
            uniform token wrap = "nonperiodic"
        }

        def Xform "attach_world_fixed_end" (
            prepend apiSchemas = ["NewtonRodAttachmentAPI"]
        )
        {
            int[] newton:nodeIndices = [0, 1, 2, 3, 4]
        }
    }

    def Scope "Looks"
    {
        def Material "CablePhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:contactDamping = 1
            float newton:contactStiffness = 100
            float physics:dynamicFriction = 0.5
            float physics:staticFriction = 0.5
        }
    }
}
