#usda 1.0
(
    defaultPrim = "World"
    doc = """Test: 40-node sagging cable attached at both ends to articulated assemblies.

    Left end: cable node 0 → CubeLeft (cube rigid body)
              CubeLeft connected via PhysicsRevoluteJoint to WallLeft (static wall mount)
              Revolute axis: Z, limited to [-45, 45] degrees

    Right end: cable node 39 → CubeRight (cube rigid body)
               CubeRight connected via PhysicsPrismaticJoint to WallRight (static wall mount)
               Prismatic axis: Z, limited to [-0.05, 0.05] m (spring-loaded slot)

    Tests:
      - PhysicsAttachment targeting bodies that are themselves jointed
      - Revolute joint with drive (left side)
      - Prismatic joint with limits (right side)
      - Cable tension transmitted through the articulated chain
      - PhysicsArticulationRootAPI scoping both assemblies"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "LeftAssembly" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        def Cube "WallLeft" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            double size = 0.04
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (-0.4, 0, 0.72)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "CubeLeft" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            float physics:mass = 0.05
            double size = 0.035
            double3 xformOp:translate = (-0.4, 0, 0.65)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def PhysicsRevoluteJoint "RevJointLeft"
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/LeftAssembly/WallLeft>
            rel physics:body1 = </World/LeftAssembly/CubeLeft>
            point3f physics:localPos0 = (0, 0, -0.035)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -45
            float physics:upperLimit = 45
        }
    }

    def Xform "RightAssembly" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        def Cube "WallRight" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            double size = 0.04
            double3 xformOp:translate = (0.4, 0, 0.62)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cube "CubeRight" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            float physics:mass = 0.05
            double size = 0.035
            double3 xformOp:translate = (0.4, 0, 0.55)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def PhysicsPrismaticJoint "PrisJointRight"
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </World/RightAssembly/WallRight>
            rel physics:body1 = </World/RightAssembly/CubeRight>
            point3f physics:localPos0 = (0, 0, -0.035)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.05
            float physics:upperLimit = 0.05
        }
    }

    def Xform "rod"
    {
        def Xform "curve_0" (
            apiSchemas = ["PhysicsDeformableBodyAPI", "MaterialBindingAPI", "NewtonArticulationRootAPI"]
        )
        {
            rel material:binding = </World/Looks/CablePhysicsMaterial> (
                bindMaterialAs = "weakerThanDescendants"
            )

            def BasisCurves "visual" (
                prepend apiSchemas = ["PhysicsCurvesDeformableSimAPI"]
            )
            {
                uniform token[] curveType = ["linear"]
                int[] curveVertexCounts = [40]
                point3f[] points = [(-0.4, 0, 0.65), (-0.37949, 0, 0.61954), (-0.35897, 0, 0.59056), (-0.33846, 0, 0.56305), (-0.31795, 0, 0.53701), (-0.29744, 0, 0.51244), (-0.27692, 0, 0.48935), (-0.25641, 0, 0.46772), (-0.2359, 0, 0.44757), (-0.21538, 0, 0.42888), (-0.19487, 0, 0.41166), (-0.17436, 0, 0.39591), (-0.15385, 0, 0.38163), (-0.13333, 0, 0.36882), (-0.11282, 0, 0.35748), (-0.09231, 0, 0.3476), (-0.07179, 0, 0.3392), (-0.05128, 0, 0.33226), (-0.03077, 0, 0.32679), (-0.01026, 0, 0.32279), (0.01026, 0, 0.32025), (0.03077, 0, 0.31919), (0.05128, 0, 0.31959), (0.07179, 0, 0.32146), (0.09231, 0, 0.32479), (0.11282, 0, 0.3296), (0.13333, 0, 0.33587), (0.15385, 0, 0.3436), (0.17436, 0, 0.3528), (0.19487, 0, 0.36346), (0.21538, 0, 0.37559), (0.2359, 0, 0.38918), (0.25641, 0, 0.40424), (0.27692, 0, 0.42076), (0.29744, 0, 0.43874), (0.31795, 0, 0.4582), (0.33846, 0, 0.47911), (0.35897, 0, 0.5015), (0.37949, 0, 0.52535), (0.4, 0, 0.55)]
                uniform token type = "linear"
                float[] widths = [0.007, 0.00724, 0.00748, 0.00771, 0.00794, 0.00816, 0.00837, 0.00857, 0.00877, 0.00895, 0.00912, 0.00927, 0.00942, 0.00955, 0.00966, 0.00976, 0.00985, 0.00992, 0.00997, 0.01001, 0.01003, 0.01004, 0.01002, 0.00999, 0.00995, 0.00988, 0.0098, 0.0097, 0.00959, 0.00946, 0.00932, 0.00916, 0.00899, 0.00881, 0.00861, 0.0084, 0.00818, 0.00795, 0.00771, 0.007]
                uniform token wrap = "nonperiodic"
            }

            def PhysicsAttachment "attachment_left"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = [(0, 0, 0)]
                float physics:damping = 0
                int[] physics:indices0 = [0]
                int[] physics:indices1 = []
                rel physics:src0 = </World/rod/curve_0/visual>
                rel physics:src1 = </World/LeftAssembly/CubeLeft>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "xform"
            }

            def PhysicsAttachment "attachment_right"
            {
                vector3f[] physics:coords0 = []
                vector3f[] physics:coords1 = [(0, 0, 0)]
                float physics:damping = 0
                int[] physics:indices0 = [39]
                int[] physics:indices1 = []
                rel physics:src0 = </World/rod/curve_0/visual>
                rel physics:src1 = </World/RightAssembly/CubeRight>
                float physics:stiffness = inf
                uniform token physics:type0 = "point"
                uniform token physics:type1 = "xform"
            }
        }
    }

    def Scope "Looks"
    {
        def Material "CablePhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "PhysicsCurvesDeformableMaterialAPI", "NewtonMaterialAPI", "NewtonCurvesDeformableMaterialAPI"]
        )
        {
            float newton:bendDamping = 0.002
            float newton:contactDamping = 1
            float newton:contactStiffness = 100
            float newton:stretchDamping = 0
            float physics:bendStiffness = 3000
            float physics:dynamicFriction = 0.5
            float physics:staticFriction = 0.5
            float physics:stretchStiffness = 200000
            float physics:thickness = 0.007
        }
    }
}
