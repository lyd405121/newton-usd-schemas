#usda 1.0
(
    defaultPrim = "World"
    doc = """Test: 40-node sagging cable attached at both ends to articulated assemblies.

    Left end: cable node 0 → CubeLeft (cube rigid body)
              CubeLeft connected via PhysicsRevoluteJoint to WallLeft (static wall mount)
              Revolute axis: Z, limited to [-45, 45] degrees

    Right end: cable node 39 → CubeRight (cube rigid body)
               CubeRight connected via PhysicsPrismaticJoint to WallRight (static wall mount)
               Prismatic axis: Z, limited to [-0.05, 0.05] m (spring-loaded slot)

    Tests:
      - NewtonRodAttachmentAPI targeting bodies that are themselves jointed
      - Revolute joint with drive (left side)
      - Prismatic joint with limits (right side)
      - Cable tension transmitted through the articulated chain
      - PhysicsArticulationRootAPI scoping both assemblies"""
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "World"
{
    def Xform "LeftAssembly" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        def Cube "WallLeft" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            double size = 0.04
            float3 xformOp:scale = (1, 1, 1)
            double3 xformOp:translate = (-0.4, 0, 0.72)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "CubeLeft" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            float physics:mass = 0.05
            double size = 0.035
            double3 xformOp:translate = (-0.4, 0, 0.65)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def PhysicsRevoluteJoint "RevJointLeft"
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </World/LeftAssembly/WallLeft>
            rel physics:body1 = </World/LeftAssembly/CubeLeft>
            point3f physics:localPos0 = (0, 0, -0.035)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -45
            float physics:upperLimit = 45
        }
    }

    def Xform "RightAssembly" (
        prepend apiSchemas = ["PhysicsArticulationRootAPI"]
    )
    {
        def Cube "WallRight" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            bool physics:kinematicEnabled = 1
            double size = 0.04
            double3 xformOp:translate = (0.4, 0, 0.62)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cube "CubeRight" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsCollisionAPI"]
        )
        {
            float physics:mass = 0.05
            double size = 0.035
            double3 xformOp:translate = (0.4, 0, 0.55)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def PhysicsPrismaticJoint "PrisJointRight"
        {
            uniform token physics:axis = "Z"
            rel physics:body0 = </World/RightAssembly/WallRight>
            rel physics:body1 = </World/RightAssembly/CubeRight>
            point3f physics:localPos0 = (0, 0, -0.035)
            point3f physics:localPos1 = (0, 0, 0)
            quatf physics:localRot0 = (1, 0, 0, 0)
            quatf physics:localRot1 = (1, 0, 0, 0)
            float physics:lowerLimit = -0.05
            float physics:upperLimit = 0.05
        }
    }

    def Xform "rod" (
        prepend apiSchemas = ["NewtonRodAPI", "MaterialBindingAPI"]
    )
    {
        rel material:binding = </World/Looks/CablePhysicsMaterial> (
            bindMaterialAs = "weakerThanDescendants"
        )
        float[] newton:bendDamping = [0.002, 0.002, 0.002, 0.002, 0.002, 0.002, 0.002, 0.002, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.001, 0.002, 0.002, 0.002, 0.002, 0.002, 0.002, 0.002]
