            uniform token type = "linear"
            float[] widths = [0.007, 0.00724, 0.00748, 0.00771, 0.00794, 0.00816, 0.00837, 0.00857, 0.00877, 0.00895, 0.00912, 0.00927, 0.00942, 0.00955, 0.00966, 0.00976, 0.00985, 0.00992, 0.00997, 0.01001, 0.01003, 0.01004, 0.01002, 0.00999, 0.00995, 0.00988, 0.0098, 0.0097, 0.00959, 0.00946, 0.00932, 0.00916, 0.00899, 0.00881, 0.00861, 0.0084, 0.00818, 0.00795, 0.00771, 0.007]
            uniform token wrap = "nonperiodic"
        }

        def Xform "attachment_left" (
            prepend apiSchemas = ["NewtonRodAttachmentAPI"]
        )
        {
            rel newton:body = </World/LeftAssembly/CubeLeft>
            point3f[] newton:localPos1 = [(0, 0, 0)]
            quatf[] newton:localRot0 = [(1, 0, 0, 0)]
            quatf[] newton:localRot1 = [(1, 0, 0, 0)]
            int[] newton:nodeIndices = [0]
        }

        def Xform "attachment_right" (
            prepend apiSchemas = ["NewtonRodAttachmentAPI"]
        )
        {
            rel newton:body = </World/RightAssembly/CubeRight>
            point3f[] newton:localPos1 = [(0, 0, 0)]
            quatf[] newton:localRot0 = [(1, 0, 0, 0)]
            quatf[] newton:localRot1 = [(1, 0, 0, 0)]
            int[] newton:nodeIndices = [39]
        }
    }

    def Scope "Looks"
    {
        def Material "CablePhysicsMaterial" (
            prepend apiSchemas = ["PhysicsMaterialAPI", "NewtonMaterialAPI"]
        )
        {
            float newton:contactDamping = 1
            float newton:contactStiffness = 100
            float physics:dynamicFriction = 0.5
            float physics:staticFriction = 0.5
        }
    }
}
